{
  "name": "investiture",
  "version": "0.1.0",
  "description": "A decoupled, enterprise-ready application scaffold for browser apps, SaaS products, and extensions",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all clean --parallel sass:watch html:watch",
    "build": "npm-run-all clean sass:build html:build",
    "clean": "rm -rf docs",
    "sass:build": "sass views/vanilla/styles.scss:views/vanilla/styles.css --style=compressed --source-map --load-path=.",
    "sass:watch": "sass views/vanilla/styles.scss:views/vanilla/styles.css --watch --source-map --load-path=.",
    "html:build": "ELEVENTY_ENV=production eleventy --config=eleventy.config.cjs",
    "html:watch": "eleventy --serve --config=eleventy.config.cjs",
    "build:netlify": "npm-run-all clean sass:build html:netlify",
    "html:netlify": "eleventy --config=eleventy.config.cjs",
    "deploy": "npm run build:netlify && npx netlify-cli deploy --prod --dir=docs",
    "deploy:preview": "npm run build:netlify && npx netlify-cli deploy --dir=docs",
    "build:tokens": "node scripts/build-tokens.js",
    "serve": "eleventy --serve --config=eleventy.config.cjs",
    "start": "npm run dev",
    "stc:react:dev": "vite --config apps/stc/views/react/vite.config.js",
    "stc:react:build": "vite build --config apps/stc/views/react/vite.config.js",
    "stc:react:preview": "vite preview --config apps/stc/views/react/vite.config.js"
  },
  "keywords": [
    "scaffold",
    "framework",
    "decoupled",
    "enterprise",
    "design-system",
    "saas"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@vitejs/plugin-react": "^5.1.2",
    "npm-run-all": "^4.1.5",
    "sass": "^1.77.0",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@supabase/supabase-js": "^2.90.1",
    "dotenv": "^17.2.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.12.0"
  }
}
