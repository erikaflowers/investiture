{
  "color": {
    "background": {
      "primary": "#1a1a2e",
      "secondary": "#16213e",
      "tertiary": "#0f0f1a"
    },
    "text": {
      "primary": "#e0e0e0",
      "secondary": "#a0a0a0",
      "muted": "#606060"
    },
    "accent": {
      "primary": "#ff6b6b",
      "secondary": "#4ecdc4",
      "warning": "#ffe66d"
    },
    "border": {
      "default": "#2a2a4a",
      "focus": "#ff6b6b"
    }
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "xxl": "48px"
  },
  "typography": {
    "fontFamily": {
      "base": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "mono": "'SF Mono', 'Fira Code', monospace"
    },
    "fontSize": {
      "xs": "12px",
      "sm": "14px",
      "md": "16px",
      "lg": "20px",
      "xl": "24px",
      "xxl": "32px"
    },
    "fontWeight": {
      "normal": "400",
      "medium": "500",
      "bold": "600"
    },
    "lineHeight": {
      "tight": "1.2",
      "base": "1.5",
      "relaxed": "1.75"
    }
  },
  "breakpoints": {
    "mobile": "480px",
    "tablet": "768px",
    "desktop": "1024px",
    "wide": "1280px"
  },
  "radius": {
    "sm": "4px",
    "md": "8px",
    "lg": "16px",
    "full": "9999px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(0,0,0,0.3)",
    "md": "0 4px 6px rgba(0,0,0,0.3)",
    "lg": "0 10px 15px rgba(0,0,0,0.4)"
  },
  "transition": {
    "fast": "150ms ease",
    "base": "250ms ease",
    "slow": "400ms ease"
  }
}
