title: Beat Sheet
description: Beat sheet builder for novelists using Blake Snyder's Save the Cat method
---

<div id="stc-app" class="stc-placeholder">
  <p class="stc-placeholder__icon">🚧</p>
  <p class="stc-placeholder__text">Under Construction</p>
  <p class="stc-placeholder__subtext">UX being designed in Mural</p>

  <!-- Database Test Panel -->
  <div class="stc-test-panel">
    <h3>Supabase Connection Test</h3>

    <div class="stc-test-panel__status" id="connection-status">
      Checking connection...
    </div>

    <div class="stc-test-panel__actions">
      <button class="button button--primary" id="btn-test-connection">
        Test Connection
      </button>
      <button class="button button--secondary" id="btn-create-project">
        Create Test Project
      </button>
    </div>

    <div class="stc-test-panel__results" id="test-results">
      <!-- Results will appear here -->
    </div>
  </div>
</div>

<script type="module">
  // Import Supabase client from CDN (static site, no bundler)
  import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';

  // Supabase config (public credentials - RLS protects data)
  const SUPABASE_URL = 'https://vfufedgmfcqwimvglvls.supabase.co';
  const SUPABASE_ANON_KEY = 'sb_publishable_vi8VVrb56M0_TAp3vo2Gow_TXzQQqCV';

  const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

  // DOM elements
  const statusEl = document.getElementById('connection-status');
  const resultsEl = document.getElementById('test-results');
  const btnTestConnection = document.getElementById('btn-test-connection');
  const btnCreateProject = document.getElementById('btn-create-project');

  // Helper to show results
  function showResult(message, isError = false) {
    const div = document.createElement('div');
    div.className = `stc-test-result ${isError ? 'stc-test-result--error' : 'stc-test-result--success'}`;
    div.innerHTML = `<span class="stc-test-result__time">${new Date().toLocaleTimeString()}</span> ${message}`;
    resultsEl.insertBefore(div, resultsEl.firstChild);
  }

  // Test connection
  async function testConnection() {
    statusEl.textContent = 'Testing connection...';
    statusEl.className = 'stc-test-panel__status stc-test-panel__status--pending';

    try {
      const { error } = await supabase.from('projects').select('count', { count: 'exact', head: true });

      if (error) {
        statusEl.textContent = `Connection failed: ${error.message}`;
        statusEl.className = 'stc-test-panel__status stc-test-panel__status--error';
        showResult(`Connection failed: ${error.message}`, true);
        return false;
      }

      statusEl.textContent = 'Connected to Supabase!';
      statusEl.className = 'stc-test-panel__status stc-test-panel__status--success';
      showResult('Successfully connected to Supabase');
      return true;
    } catch (e) {
      statusEl.textContent = `Connection error: ${e.message}`;
      statusEl.className = 'stc-test-panel__status stc-test-panel__status--error';
      showResult(`Connection error: ${e.message}`, true);
      return false;
    }
  }

  // Create test project
  async function createTestProject() {
    showResult('Creating test project...');

    try {
      // Create project
      const { data: project, error: projectError } = await supabase
        .from('projects')
        .insert({
          title: `Test Project ${Date.now()}`,
          status: 'braindump',
          user_id: null, // No auth yet
        })
        .select()
        .single();

      if (projectError) {
        showResult(`Failed to create project: ${projectError.message}`, true);
        return;
      }

      showResult(`Created project: <strong>${project.title}</strong> (ID: ${project.id})`);

      // Create a braindump for it
      const { data: braindump, error: braindumpError } = await supabase
        .from('braindumps')
        .insert({
          project_id: project.id,
          raw_input: 'This is a test braindump created from the STC app to verify Supabase connectivity.',
        })
        .select()
        .single();

      if (braindumpError) {
        showResult(`Failed to create braindump: ${braindumpError.message}`, true);
        return;
      }

      showResult(`Created braindump for project (ID: ${braindump.id})`);
      showResult('<strong>Success!</strong> Data is now in Supabase. Check your dashboard.');

    } catch (e) {
      showResult(`Error: ${e.message}`, true);
    }
  }

  // Event listeners
  btnTestConnection.addEventListener('click', testConnection);
  btnCreateProject.addEventListener('click', createTestProject);

  // Auto-test on load
  testConnection();
</script>

